{
  "name": "vuna-calc-striped",
  "version": "1.0.0",
  "description": "An advanced calculator app with a production-grade CI/CD pipeline",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage --coverageReporters=json --coverageReporters=text --coverageReporters=lcov",
    "test:ci": "jest --coverage --coverageReporters=json-summary --ci --forceExit",
    "lint": "eslint src/ --ext .js",
    "build": "node scripts/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeratBali/VUNA-Calc-striped.git"
  },
  "keywords": [],
  "author": "Software Engineering Set 2025/26",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/NeratBali/VUNA-Calc-striped/issues"
  },
  "homepage": "https://github.com/NeratBali/VUNA-Calc-striped#readme",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageThreshold": {
      "global": { "branches": 70, "functions": 70, "lines": 80, "statements": 80 }
    }
  }
}